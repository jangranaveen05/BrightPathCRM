# BrightPath CRM — Environment Configuration Template
# Copy this file to .env and fill in your real Supabase credentials.
# Note: Variables prefixed with VITE_ are bundled into client code.
# NEVER put your Supabase service_role key or database password in this file.

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
